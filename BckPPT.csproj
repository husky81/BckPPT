<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 트레이 아이콘(NotifyIcon)만 쓴다. WPF 형식과 이름이 겹치지 않게 전역 using은 뺀다. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BckPPT</RootNamespace>
    <AssemblyName>BckPPT</AssemblyName>
    <NoWarn>MVVMTK0045</NoWarn>
    <!-- 실제 버전은 커밋 기반: run.ps1·scripts\package*.ps1이 tools\Get-CommitVersion.ps1로 계산해 넘긴다.
         이 값은 그 스크립트를 거치지 않은 빌드에만 남는다. -->
    <Version>0.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <!-- 루트 아래 작업 폴더의 obj(AssemblyInfo 등)가 섞이면 특성 중복으로 빌드가 깨진다. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tmp\**;artifacts\**;BckPPT.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.*" />
    <PackageReference Include="Microsoft.Office.Interop.PowerPoint" Version="15.0.4420.1017" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.*" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Compile Remove="BckPPT.Tests\**\*.cs" />
  </ItemGroup>

</Project>
