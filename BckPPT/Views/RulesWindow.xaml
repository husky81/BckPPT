<Window
    x:Class="CellBox2.BckPPT.Views.RulesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="치환 규칙 편집" Width="620" Height="420"
    WindowStartupLocation="CenterOwner"
    Background="#1E1E1E"
    Icon="/Assets/icon.ico">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 안내 -->
        <TextBlock Grid.Row="0" Margin="0,0,0,8" Foreground="#888" FontSize="11" FontFamily="Segoe UI"
                   Text="프레젠테이션 전체에 일괄 적용할 Find→Replace 규칙을 편집하세요. 저장 후 '규칙 치환' 버튼으로 실행합니다."/>

        <!-- 규칙 DataGrid -->
        <DataGrid Grid.Row="1"
                  x:Name="RulesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  CanUserSortColumns="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#2D2D2D"
                  Background="#1E1E1E"
                  RowBackground="#252526"
                  Foreground="#CCC"
                  FontFamily="Segoe UI" FontSize="12"
                  BorderBrush="#3C3C3C" BorderThickness="1"
                  ColumnHeaderHeight="26"
                  RowHeight="26">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D2D"/>
                    <Setter Property="Foreground" Value="#888"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="BorderBrush" Value="#3C3C3C"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#CCC"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#264F78"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter Property="Background" Value="#1E3A5F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="찾을 텍스트 (Find)"    Binding="{Binding Find}"    Width="*"/>
                <DataGridTextColumn Header="바꿀 텍스트 (Replace)"  Binding="{Binding Replace}" Width="*"/>
                <DataGridCheckBoxColumn Header="대소문자 구분"       Binding="{Binding CaseSensitive}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 버튼 -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="행 추가" Padding="10,5"
                    Style="{StaticResource DarkBtn}" Margin="0,0,6,0"
                    Click="AddRow_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="저장" Padding="16,6" Margin="0,0,8,0"
                        Style="{StaticResource AccentBtn}" Click="Save_Click"/>
                <Button Content="취소" Padding="16,6"
                        Style="{StaticResource DarkBtn}" Click="Cancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
