<Window x:Class="BckPPT.Views.AgentChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:BckPPT.Views"
        Title="BckPPT" Width="460" Height="820" MinWidth="340" MinHeight="420"
        Background="{StaticResource AppBg}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
        <FontFamily x:Key="BodyFont">Segoe UI, Malgun Gothic</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, D2Coding, Consolas, Malgun Gothic</FontFamily>
        <SolidColorBrush x:Key="StreamBg" Color="#232325"/>
        <SolidColorBrush x:Key="PromptBg" Color="#2B2B2E"/>

        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBr}"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{StaticResource TextBr}"/>
        </Style>

        <!-- 글자만 있는 단추(접기·링크·메뉴 항목) -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SubTextBr}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBr}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Foreground" Value="{StaticResource TextBr}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBr}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBr}"/>
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="12,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ── 작업 흐름 항목 (Claude Code 터미널처럼: ● 답·도구, ⎿ 결과, > 내 요청) ── -->
        <SolidColorBrush x:Key="DotBr" Color="#D4D4D4"/>
        <Style x:Key="Gutter" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <DataTemplate DataType="{x:Type v:NarrationEntry}">
            <DockPanel Margin="0,4,0,4">
                <TextBlock DockPanel.Dock="Left" Text="●" Style="{StaticResource Gutter}" Foreground="{StaticResource DotBr}" FontSize="9" Margin="0,5,0,0"/>
                <TextBlock v:MarkdownText.Text="{Binding Text}" Style="{StaticResource Body}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:AnswerEntry}">
            <DockPanel Margin="0,6,0,4">
                <TextBlock DockPanel.Dock="Left" Text="●" Style="{StaticResource Gutter}" Foreground="{StaticResource DotBr}" FontSize="9" Margin="0,5,0,0"/>
                <TextBlock v:MarkdownText.Text="{Binding Text}" Style="{StaticResource Body}"/>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:NoteEntry}">
            <DockPanel Margin="0,3,0,3">
                <TextBlock DockPanel.Dock="Left" Text="※" Style="{StaticResource Gutter}" Foreground="{StaticResource SubTextBr}" FontSize="11"/>
                <TextBlock x:Name="T" Text="{Binding Text}" Style="{StaticResource Body}" FontSize="12" LineHeight="18"
                           Foreground="{StaticResource SubTextBr}"/>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Warning}" Value="True">
                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource WarnBr}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type v:ToolStepEntry}">
            <StackPanel Margin="0,4,0,2" ToolTip="{Binding ToolName}">
                <DockPanel>
                    <TextBlock x:Name="Dot" DockPanel.Dock="Left" Text="●" Style="{StaticResource Gutter}" FontSize="9" Margin="0,4,0,0"
                               Foreground="{StaticResource SuccessBr}"/>
                    <TextBlock Style="{StaticResource Mono}">
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run x:Name="Args" Text="{Binding Detail, Mode=OneWay, StringFormat='({0})'}" Foreground="{StaticResource SubTextBr}"/>
                    </TextBlock>
                </DockPanel>
                <DockPanel Margin="16,1,0,0">
                    <TextBlock DockPanel.Dock="Left" Text="⎿" Style="{StaticResource Mono}" Foreground="{StaticResource SubTextBr}" Margin="2,0,8,0"/>
                    <TextBlock x:Name="R" Style="{StaticResource Mono}" Foreground="{StaticResource SubTextBr}">
                        <Run x:Name="Spin" Text="{Binding Icon, Mode=OneWay}"/>
                        <Run Text="{Binding Result, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Detail}" Value="">
                    <Setter TargetName="Args" Property="Text" Value=""/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Spin" Property="Text" Value=""/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource ErrorBr}"/>
                    <Setter TargetName="R" Property="Foreground" Value="{StaticResource ErrorBr}"/>
                    <Setter TargetName="Spin" Property="Text" Value=""/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                    <Setter TargetName="Dot" Property="Foreground" Value="{StaticResource AccentBr}"/>
                    <Setter TargetName="Spin" Property="Foreground" Value="{StaticResource AccentBr}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── 요청 하나 ── -->
        <DataTemplate DataType="{x:Type v:ConsoleTurn}">
            <StackPanel Margin="0,0,0,18">
                <!-- 내 요청: > 를 붙이고 음영 -->
                <Border Background="{StaticResource PromptBg}" CornerRadius="3" Padding="8,6" Margin="0,0,0,8"
                        Visibility="{Binding HasRequest, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&gt;" Style="{StaticResource Mono}" Foreground="{StaticResource SubTextBr}"
                                   Width="16" Margin="0,1,0,0"/>
                        <TextBlock Text="{Binding Request}" Style="{StaticResource Body}"/>
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource FlatBtn}" Click="ToggleActivity_Click" Margin="0,0,0,2"
                        Visibility="{Binding ShowSummaryToggle, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource SubTextBr}">
                        <Run Text="● " FontSize="9" Foreground="{StaticResource SuccessBr}"/><Run Text="{Binding SummaryHeader, Mode=OneWay}"/>
                    </TextBlock>
                </Button>
                <ItemsControl ItemsSource="{Binding Activity}" Visibility="{Binding ShowActivity, Converter={StaticResource Vis}}"/>
                <!-- LLM을 기다리는 동안: ✻ 여백을 재는 중… (12초) -->
                <TextBlock Style="{StaticResource Mono}" Margin="0,6,0,2" Visibility="{Binding IsWaiting, Converter={StaticResource Vis}}">
                    <Run Text="{Binding WaitStar, Mode=OneWay}" Foreground="#E8A15F"/><Run Text=" "/><Run Text="{Binding WaitText, Mode=OneWay}" Foreground="#E8A15F"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Outcome}"/>
                <Button Style="{StaticResource FlatBtn}" Click="ToggleChanges_Click" Margin="16,4,0,0"
                        Visibility="{Binding HasChanges, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource SubTextBr}">
                        <Run Text="⎿  "/><Run Text="{Binding ChangesHeader, Mode=OneWay}"/>
                    </TextBlock>
                </Button>
                <ItemsControl ItemsSource="{Binding Changes}" Margin="38,2,0,0"
                              Visibility="{Binding ChangesExpanded, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource SubTextBr}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Thumbnails}" Margin="16,8,0,0"
                              Visibility="{Binding HasThumbnails, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatBtn}" Margin="0,0,6,6" Click="Thumbnail_Click" ToolTip="누르면 PowerPoint에서 이 쪽으로 갑니다">
                                <Grid>
                                    <Border BorderBrush="{StaticResource BorderBr}" BorderThickness="1">
                                        <Image Source="{Binding ImagePath}" Width="96" Stretch="Uniform"/>
                                    </Border>
                                    <Border Background="#B01E1E1E" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="4,0" Margin="1">
                                        <TextBlock Text="{Binding Caption}" FontSize="10" Foreground="{StaticResource TextBr}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── 상태줄: ● 파일명 경로 쪽 ⋯ ── -->
        <Border Background="{StaticResource HeaderBg}" BorderBrush="{StaticResource BorderBr}" BorderThickness="0,0,0,1">
            <Grid x:Name="StatusBar" Height="32" Margin="12,0,4,0" SizeChanged="StatusBar_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding LightBrush}" VerticalAlignment="Center" ToolTip="{Binding LightTooltip}"/>
                <Button x:Name="FileButton" Grid.Column="1" Style="{StaticResource FlatBtn}" Click="FileName_Click" Margin="5,0,8,0" Padding="4,3"
                        ToolTip="{Binding TargetTooltip}" IsEnabled="{Binding CanSend}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📌" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsPinned, Converter={StaticResource Vis}}"/>
                        <TextBlock x:Name="FileNameText" Text="{Binding FileNameDisplay}" FontFamily="{StaticResource BodyFont}" FontSize="12.5"
                                   Foreground="{StaticResource TextBr}"/>
                        <TextBlock x:Name="FolderText" Text="{Binding FolderDisplay}" FontFamily="{StaticResource BodyFont}" FontSize="11"
                                   Foreground="{StaticResource SubTextBr}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="▾" FontSize="10" Foreground="{StaticResource SubTextBr}" Margin="6,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="FilePopup" Grid.Column="1" PlacementTarget="{Binding ElementName=FileButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                            CornerRadius="6" Padding="0,6" MinWidth="300" MaxWidth="440">
                        <StackPanel>
                            <TextBlock Text="열린 PowerPoint 문서가 없습니다" Foreground="{StaticResource SubTextBr}" FontSize="12" Margin="12,6"
                                       Visibility="{Binding NoOpenFiles, Converter={StaticResource Vis}}"/>
                            <ItemsControl ItemsSource="{Binding OpenFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuBtn}" Click="OpenFileItem_Click" ToolTip="{Binding Path}">
                                            <Grid x:Name="Row">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="✓" Foreground="{StaticResource SuccessBr}"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="{StaticResource SubTextBr}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding SlideText}" FontSize="11" Foreground="{StaticResource SubTextBr}"
                                                           Margin="12,1,0,0"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Background="{StaticResource BorderBr}" Margin="0,4"/>
                            <Button Style="{StaticResource MenuBtn}" Content="{Binding PinLabel}" Click="Pin_Click"
                                    IsEnabled="{Binding HasTarget}"
                                    ToolTip="고정하면 PowerPoint에서 다른 문서를 봐도 이 문서에서 작업합니다"/>
                            <Button Style="{StaticResource MenuBtn}" Content="PPT 파일 열기…" Click="OpenFile_Click"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <TextBlock Grid.Column="2" Text="{Binding SlideDisplay}" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                           Foreground="{StaticResource SubTextBr}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource FlatBtn}" Click="More_Click" Width="30" Height="26"
                        HorizontalContentAlignment="Center" ToolTip="메뉴">
                    <TextBlock Text="⋯" FontSize="16" Margin="0,-4,0,0"/>
                </Button>
                <Popup x:Name="MenuPopup" Grid.Column="3" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-214" VerticalOffset="4">
                    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBr}" BorderThickness="1"
                            CornerRadius="6" Padding="0,6" Width="244">
                        <StackPanel>
                            <Button Style="{StaticResource MenuBtn}" Content="PPT 파일 열기…" Click="OpenFile_Click"/>
                            <Button Style="{StaticResource MenuBtn}" Content="{Binding AttachMenuText}" Click="AttachSources_Click"/>
                            <Button Style="{StaticResource MenuBtn}" Content="첨부 원문 모두 빼기" Click="DetachSources_Click"
                                    Visibility="{Binding HasSources, Converter={StaticResource Vis}}"/>
                            <Button Style="{StaticResource MenuBtn}" Content="템플릿 폴더 인덱싱…" Click="IndexFolder_Click"/>
                            <Button Style="{StaticResource MenuBtn}" Content="전문 편집창" Click="OpenEditor_Click"/>
                            <Separator Background="{StaticResource BorderBr}" Margin="0,4"/>
                            <CheckBox Style="{StaticResource MenuCheck}" Content="열린 PowerPoint에서 바로 작업" IsChecked="{Binding WorkInOpenWindow}"
                                      ToolTip="대상 PPT가 창에 열려 있으면 그 창에서 새 쪽을 만들어 작업합니다. 저장은 직접 합니다"/>
                            <CheckBox Style="{StaticResource MenuCheck}" Content="길이 맞춤에 LLM 사용" IsChecked="{Binding LlmFit}"/>
                            <CheckBox Style="{StaticResource MenuCheck}" Content="항상 위" IsChecked="{Binding StayOnTop}"/>
                            <Separator Background="{StaticResource BorderBr}" Margin="0,4"/>
                            <Button Style="{StaticResource MenuBtn}" Content="LLM 사용량" Click="Usage_Click"/>
                            <Button Style="{StaticResource MenuBtn}" Content="작업 기록 폴더 열기" Click="OpenLogs_Click"/>
                            <StackPanel Visibility="{Binding HasSession, Converter={StaticResource Vis}}">
                                <Separator Background="{StaticResource BorderBr}" Margin="0,4"/>
                                <Button Style="{StaticResource MenuBtn}" Content="{Binding ApproveLabel}" Click="ApproveAgent_Click" IsEnabled="{Binding CanSend}"/>
                                <Button Style="{StaticResource MenuBtn}" Content="결과 열어 보기" Click="OpenWorkingCopy_Click"
                                        Visibility="{Binding ShowOpenWorkingCopy, Converter={StaticResource Vis}}"/>
                                <Button Style="{StaticResource MenuBtn}" Content="{Binding DiscardLabel}" Click="DiscardAgent_Click" IsEnabled="{Binding CanSend}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- ── 작업 흐름 ── -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="ConversationScroll_ScrollChanged"
                          Padding="16,14,12,4">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Body}" Foreground="{StaticResource SubTextBr}"
                               Visibility="{Binding ShowEmptyHint, Converter={StaticResource Vis}}" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding Turns}"/>
                </StackPanel>
            </ScrollViewer>
            <Button Style="{StaticResource FlatBtn}" Click="JumpToEnd_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,8" Background="{StaticResource PanelBg}" Padding="10,3"
                    Visibility="{Binding ShowJumpToEnd, Converter={StaticResource Vis}}">
                <TextBlock Text="↓ 새 작업 내용" FontSize="11.5" Foreground="{StaticResource TextBr}"/>
            </Button>
        </Grid>

        <!-- ── 입력: 둥근 상자 하나(› 입력 ↑) + 아래 작은 안내 줄 ── -->
        <StackPanel Grid.Row="2" Margin="12,6,12,10">
            <Grid>
                <!-- 그림자는 뒤의 빈 상자에만 준다(입력 상자에 주면 글자가 흐려진다). -->
                <Border CornerRadius="9" Background="#252527" Margin="1">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="Black"/></Border.Effect>
                </Border>
                <Border x:Name="InputFrame" CornerRadius="9" Background="#252527" BorderThickness="1" Padding="10,5,5,5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#3A3A3E"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#3D6A9A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="›" FontFamily="{StaticResource MonoFont}" FontSize="15" Foreground="{StaticResource SubTextBr}"
                                   Margin="0,3,8,0" VerticalAlignment="Top"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="InstructionBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBr}"
                                     CaretBrush="Transparent" SelectionBrush="{StaticResource AccentBr}" SelectionOpacity="0.45"
                                     AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" FontFamily="{StaticResource BodyFont}" FontSize="13.5"
                                     MinHeight="26" MaxHeight="176" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="0,3"
                                     PreviewKeyDown="InstructionBox_KeyDown" TextChanged="InstructionBox_TextChanged"
                                     SelectionChanged="InstructionBox_SelectionChanged"
                                     GotKeyboardFocus="InstructionBox_FocusChanged" LostKeyboardFocus="InstructionBox_FocusChanged"
                                     SizeChanged="InstructionBox_SizeChanged">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock x:Name="Placeholder" Text="무엇을 할까요?" IsHitTestVisible="False"
                                       Foreground="{StaticResource SubTextBr}" FontFamily="{StaticResource BodyFont}" FontSize="13.5" Margin="2,3,0,0"/>
                            <!-- 직접 그리는 커서: 강조색, 끝이 둥근 2px 막대 -->
                            <Canvas x:Name="CaretCanvas" IsHitTestVisible="False" ClipToBounds="True">
                                <Rectangle x:Name="Caret" Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="#5AA9F0" Visibility="Hidden"/>
                            </Canvas>
                        </Grid>
                        <Button Grid.Column="2" Click="SendOrStop_Click" ToolTip="{Binding SendTooltip}" VerticalAlignment="Bottom"
                                Margin="6,0,0,0" Cursor="Hand" Opacity="{Binding SendOpacity}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="28" Height="28">
                                        <Ellipse x:Name="Dot" Fill="{StaticResource AccentBr}"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Dot" Property="Fill" Value="#1A8AD8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{Binding SendGlyph}" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,-1,0,0"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
            <DockPanel Margin="6,5,6,0">
                <TextBlock DockPanel.Dock="Right" Text="↑ 이전 요청" FontSize="11" Foreground="{StaticResource SubTextBr}"
                           Visibility="{Binding ShowHistoryHint, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding KeyHint}" FontSize="11" Foreground="{StaticResource SubTextBr}"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
